rules_version = '2';

// ============================================================
//  GlucoGuard-T1D — Firebase Storage Security Rules
//  Users may only read/write files inside their own /users/{uid}/ folder.
//  Files must be images and must not exceed 8 MB.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // ----------------------------------------------------------
    //  Per-user storage path
    //  Path:  /users/{uid}/**
    //
    //  Conditions:
    //    1. User is authenticated.
    //    2. UID in path matches the authenticated user's UID.
    //    3. File size is below 8 MB.
    //    4. MIME type starts with "image/" (write only).
    //       Reads are allowed for all files in the user's folder.
    // ----------------------------------------------------------
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null
                  && request.auth.uid == uid;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ----------------------------------------------------------
    //  Deny all other paths
    // ----------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
