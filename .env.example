# ============================================================
#  GlucoGuard-T1D — Firebase Configuration Template
#  Copy this file to firebase-config.js and fill in your values.
#  NEVER commit real credentials — firebase-config.js is in .gitignore.
# ============================================================

# Firebase web API keys are public by design (they identify your Firebase project
# in the browser). Access control is enforced by Firestore security rules and
# Firebase Authentication — NOT by keeping the API key secret.
# See: https://firebase.google.com/docs/projects/api-keys

FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=G-your-measurement-id

# ============================================================
#  HOW TO GET THESE VALUES
# ============================================================
#  1. Go to https://console.firebase.google.com
#  2. Select (or create) your project
#  3. Click the gear icon → Project Settings
#  4. Scroll to "Your apps" → select your Web App
#  5. Copy the firebaseConfig object values into the fields above
#
#  For detailed setup instructions, see: docs/FIREBASE_SETUP.md
# ============================================================
